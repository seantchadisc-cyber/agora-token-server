name: Keep Render Alive
on:
  schedule:
    - cron: '*/14 * * * *'  # Runs every 14 minutes
  workflow_dispatch:        # Lets you run it manually to test

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Token Server
        run: curl -s https://agora-token-server-ysyt.onrender.com/ > /dev/null
